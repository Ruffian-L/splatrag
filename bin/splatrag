#!/usr/bin/env bash
# splatrag — peer-style cmd surface for SplatLens + embedder + palace UI
#
#   splatrag              status (ports + live /api/status when up)
#   splatrag embed        start Qwen embedder on :8081
#   splatrag label        start labeler on :8082
#   splatrag lens|serve   start SplatLens (default config → :8767)
#   splatrag palace       start TanStack palace UI on :8080 → live core
#   splatrag up           embed + lens + palace
#   splatrag stop         stop lens + palace (keep embedder)
#   splatrag stop-embed   stop :8081
#   splatrag stop-all     stop lens, palace, embed, label
#   splatrag open         print / open palace URL
#
# Rust engine (pass-through):
#   splatrag recall|remember|dream|status-store|doctor|mcp|…
#   (anything not listed above → target/release/splatrag)
#
set -euo pipefail

_SELF="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1; then
  _SELF="$(readlink -f "$_SELF" 2>/dev/null || echo "$_SELF")"
fi
ROOT="$(cd "$(dirname "$_SELF")/.." && pwd)"
cd "$ROOT"

LLAMA="${LLAMA:-$HOME/.local/bin/llama-server}"
MODELS="${MODELS:-/media/ruffianl/ghost_team/models}"
EMBED_MODEL="${EMBED_MODEL:-$MODELS/Qwen3-Embedding-8B-Q8_0.gguf}"
LABEL_MODEL="${LABEL_MODEL:-$MODELS/gemma-4-12b-it-Q4_K_M.gguf}"
LOGS="${SPLATRAG_LOGS:-/tmp/splatrag-logs}"
CONFIG="${SPLATRAG_CONFIG:-$ROOT/splatrag.toml}"
LENS_PORT="${SPLATRAG_LENS_PORT:-8767}"
EMBED_PORT="${SPLATRAG_EMBED_PORT:-8081}"
LABEL_PORT="${SPLATRAG_LABEL_PORT:-8082}"
PALACE_PORT="${SPLATRAG_PALACE_PORT:-8080}"
PALACE_DIR="${SPLATRAG_PALACE_DIR:-$HOME/projects/splatrag-palace}"
BIN="${SPLATRAG_BIN:-$ROOT/target/release/splatrag}"

mkdir -p "$LOGS"

c_ok()  { printf '\033[32m%s\033[0m\n' "$*"; }
c_bad() { printf '\033[31m%s\033[0m\n' "$*"; }
c_dim() { printf '\033[2m%s\033[0m\n' "$*"; }

port_listening() {
  # localhost-only stack (prefer 127.0.0.1; reject accidental 0.0.0.0 in status)
  ss -ltn 2>/dev/null | grep -qE "127\\.0\\.0\\.1:$1 "
}

health_up() {
  curl -sf --max-time 2 "http://127.0.0.1:$1/health" >/dev/null 2>&1
}

api_up() {
  curl -sf --max-time 2 "http://127.0.0.1:$1/api/status" >/dev/null 2>&1
}

http_ok() {
  local code
  code=$(curl -s --max-time 2 -o /dev/null -w "%{http_code}" "http://127.0.0.1:$1/" 2>/dev/null || echo 000)
  [[ "$code" == "200" || "$code" == "302" || "$code" == "304" ]]
}

ensure_bin() {
  if [[ -x "$BIN" ]]; then
    return 0
  fi
  c_dim "building release binary…"
  (cd "$ROOT" && cargo build --release)
  [[ -x "$BIN" ]] || {
    c_bad "no binary at $BIN"
    return 1
  }
}

load_nvm() {
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  # shellcheck disable=SC1091
  [[ -s "$NVM_DIR/nvm.sh" ]] && . "$NVM_DIR/nvm.sh"
  command -v npm >/dev/null 2>&1
}

start_embed() {
  if health_up "$EMBED_PORT"; then
    c_ok "embedder :$EMBED_PORT already up"
    return 0
  fi
  if [[ ! -x "$LLAMA" ]]; then
    c_bad "llama-server not found at $LLAMA"
    return 1
  fi
  if [[ ! -e "$EMBED_MODEL" ]]; then
    c_bad "embed model missing: $EMBED_MODEL"
    return 1
  fi
  c_dim "starting embedder :$EMBED_PORT $(basename "$EMBED_MODEL")"
  # --ubatch-size is load-bearing (see start.sh). 2048 fits this box's unified memory.
  nohup "$LLAMA" --model "$EMBED_MODEL" --host 127.0.0.1 --port "$EMBED_PORT" \
    --n-gpu-layers 999 --flash-attn on \
    --embedding --pooling last --ubatch-size 2048 --batch-size 2048 \
    >"$LOGS/${EMBED_PORT}.log" 2>&1 &
  echo $! >"$LOGS/embed.pid"
  printf "  waiting"
  for _ in $(seq 90); do
    if health_up "$EMBED_PORT"; then
      echo
      c_ok "embedder :$EMBED_PORT ok"
      return 0
    fi
    printf .
    sleep 2
  done
  echo
  c_bad "embedder :$EMBED_PORT failed — see $LOGS/${EMBED_PORT}.log"
  return 1
}

start_label() {
  if health_up "$LABEL_PORT"; then
    c_ok "labeler :$LABEL_PORT already up"
    return 0
  fi
  if [[ ! -x "$LLAMA" ]]; then
    c_bad "llama-server not found at $LLAMA"
    return 1
  fi
  if [[ ! -e "$LABEL_MODEL" ]]; then
    c_bad "label model missing: $LABEL_MODEL"
    return 1
  fi
  c_dim "starting labeler :$LABEL_PORT $(basename "$LABEL_MODEL")"
  nohup "$LLAMA" --model "$LABEL_MODEL" --host 127.0.0.1 --port "$LABEL_PORT" \
    --n-gpu-layers 999 --flash-attn on --ctx-size 4096 \
    >"$LOGS/${LABEL_PORT}.log" 2>&1 &
  echo $! >"$LOGS/label.pid"
  printf "  waiting"
  for _ in $(seq 90); do
    if health_up "$LABEL_PORT"; then
      echo
      c_ok "labeler :$LABEL_PORT ok"
      return 0
    fi
    printf .
    sleep 2
  done
  echo
  c_bad "labeler :$LABEL_PORT failed — see $LOGS/${LABEL_PORT}.log"
  return 1
}

start_lens() {
  if api_up "$LENS_PORT"; then
    c_ok "SplatLens :$LENS_PORT already up"
    return 0
  fi
  if port_listening "$LENS_PORT"; then
    c_bad ":$LENS_PORT in use but /api/status not responding — see $LOGS/viewer-${LENS_PORT}.log"
    return 1
  fi
  ensure_bin
  if [[ ! -f "$CONFIG" ]]; then
    c_bad "config missing: $CONFIG"
    return 1
  fi
  c_dim "starting SplatLens --config $CONFIG → :$LENS_PORT"
  nohup "$BIN" --config "$CONFIG" serve >"$LOGS/viewer-${LENS_PORT}.log" 2>&1 &
  echo $! >"$LOGS/lens.pid"
  sleep 1
  for _ in $(seq 20); do
    if api_up "$LENS_PORT"; then
      c_ok "SplatLens  http://127.0.0.1:$LENS_PORT"
      return 0
    fi
    sleep 0.5
  done
  c_bad "SplatLens failed — see $LOGS/viewer-${LENS_PORT}.log"
  tail -20 "$LOGS/viewer-${LENS_PORT}.log" || true
  return 1
}

start_palace() {
  if http_ok "$PALACE_PORT"; then
    c_ok "palace :$PALACE_PORT already up → http://127.0.0.1:$PALACE_PORT/palace"
    return 0
  fi
  if [[ ! -d "$PALACE_DIR" || ! -f "$PALACE_DIR/package.json" ]]; then
    c_bad "palace app not found at $PALACE_DIR"
    c_dim "unzip splatrag-palace-FULL-APP.zip there, or set SPLATRAG_PALACE_DIR"
    return 1
  fi
  if ! load_nvm; then
    c_bad "npm not found — install Node 22+ (nvm recommended)"
    return 1
  fi
  if [[ ! -d "$PALACE_DIR/node_modules" ]]; then
    c_dim "npm install in $PALACE_DIR"
    (cd "$PALACE_DIR" && npm install)
  fi
  # point proxy at live SplatLens
  printf 'SPALTRAG_API_URL=http://127.0.0.1:%s\n' "$LENS_PORT" >"$PALACE_DIR/.env"
  printf 'SPALTRAG_API_URL=http://127.0.0.1:%s\n' "$LENS_PORT" >"$PALACE_DIR/.env.local"
  c_dim "starting palace UI :$PALACE_PORT (SPALTRAG_API_URL=http://127.0.0.1:$LENS_PORT)"
  (
    cd "$PALACE_DIR"
    # shellcheck disable=SC1091
    load_nvm
    export SPALTRAG_API_URL="http://127.0.0.1:$LENS_PORT"
    nohup npm run dev >"$LOGS/palace-${PALACE_PORT}.log" 2>&1 &
    echo $! >"$LOGS/palace.pid"
  )
  printf "  waiting"
  for _ in $(seq 60); do
    if http_ok "$PALACE_PORT"; then
      echo
      c_ok "palace  http://127.0.0.1:$PALACE_PORT/"
      c_ok "        http://127.0.0.1:$PALACE_PORT/palace"
      return 0
    fi
    printf .
    sleep 1
  done
  echo
  c_bad "palace failed — see $LOGS/palace-${PALACE_PORT}.log"
  tail -30 "$LOGS/palace-${PALACE_PORT}.log" || true
  return 1
}

stop_port_listeners() {
  # best-effort: kill listeners on a port (linux fuser)
  local port="$1"
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "${port}/tcp" >/dev/null 2>&1 || true
  fi
}

cmd_stop_embed() {
  stop_port_listeners "$EMBED_PORT"
  c_ok "stopped embedder :$EMBED_PORT (if it was up)"
}

cmd_stop_label() {
  stop_port_listeners "$LABEL_PORT"
  c_ok "stopped labeler :$LABEL_PORT (if it was up)"
}

cmd_stop_lens() {
  stop_port_listeners "$LENS_PORT"
  c_ok "stopped SplatLens :$LENS_PORT (if it was up)"
}

cmd_stop_palace() {
  stop_port_listeners "$PALACE_PORT"
  c_ok "stopped palace :$PALACE_PORT (if it was up)"
}

cmd_stop() {
  cmd_stop_palace
  cmd_stop_lens
}

cmd_stop_all() {
  cmd_stop
  cmd_stop_embed
  cmd_stop_label
}

cmd_up() {
  start_embed
  start_lens
  start_palace
  cmd_status
}

cmd_status() {
  echo "splatrag stack"
  if health_up "$EMBED_PORT"; then
    c_ok "  embedder  :$EMBED_PORT  up"
  else
    c_bad "  embedder  :$EMBED_PORT  down   → splatrag embed"
  fi
  if health_up "$LABEL_PORT"; then
    c_ok "  labeler   :$LABEL_PORT  up"
  else
    c_dim "  labeler   :$LABEL_PORT  down   → splatrag label  (optional)"
  fi
  if api_up "$LENS_PORT"; then
    c_ok "  SplatLens :$LENS_PORT  up   http://127.0.0.1:$LENS_PORT"
    curl -s --max-time 3 "http://127.0.0.1:$LENS_PORT/api/status" 2>/dev/null \
      | python3 -c 'import json,sys; s=json.load(sys.stdin); print("             cold=%s basins=%s dream=%s scope=%s" % (s.get("cold_records"), s.get("basins"), s.get("dream_cycle"), s.get("scope_key")))' \
      2>/dev/null || true
  else
    c_bad "  SplatLens :$LENS_PORT  down   → splatrag lens"
  fi
  if http_ok "$PALACE_PORT"; then
    c_ok "  palace    :$PALACE_PORT  up   http://127.0.0.1:$PALACE_PORT/palace"
  else
    c_bad "  palace    :$PALACE_PORT  down   → splatrag palace"
  fi
  c_dim "  logs: $LOGS"
  c_dim "  peer: peer status   |   this: splatrag up"
}

cmd_open() {
  local url="http://127.0.0.1:$PALACE_PORT/palace"
  echo "$url"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  fi
}

usage() {
  cat <<EOF
splatrag — SplatLens / embedder / palace (peer-style)

  splatrag              status
  splatrag up           embed + SplatLens + palace UI
  splatrag embed        start embedder :${EMBED_PORT}
  splatrag label        start labeler  :${LABEL_PORT}
  splatrag lens|serve   start SplatLens :${LENS_PORT}
  splatrag palace       start UI :${PALACE_PORT} → live core
  splatrag open         print/open palace URL
  splatrag stop         stop lens + palace
  splatrag stop-embed   stop embedder
  splatrag stop-all     stop everything this tool owns

  # engine (Rust binary)
  splatrag recall "…"
  splatrag remember "…"
  splatrag dream
  splatrag doctor
  splatrag cli --help

Env:
  SPLATRAG_CONFIG       default $CONFIG
  SPLATRAG_PALACE_DIR   default $PALACE_DIR
  SPLATRAG_LOGS         default $LOGS
  MODELS / EMBED_MODEL / LABEL_MODEL / LLAMA

Peer tooling: same ~/.local/bin style as \`peer\`. Also: peer splatrag …
EOF
}

passthrough() {
  ensure_bin
  exec "$BIN" --config "$CONFIG" "$@"
}

main() {
  local cmd="${1:-status}"
  shift || true
  case "$cmd" in
    status|st)     cmd_status ;;
    embed|emb|embedding) start_embed ;;
    label|labeler) start_label ;;
    lens|serve|viewer) start_lens ;;
    palace|ui|frontend|fe) start_palace ;;
    up|start|all)  cmd_up ;;
    open|browse)   cmd_open ;;
    stop)          cmd_stop ;;
    stop-embed|stop-emb) cmd_stop_embed ;;
    stop-label)    cmd_stop_label ;;
    stop-lens|stop-serve) cmd_stop_lens ;;
    stop-palace|stop-ui) cmd_stop_palace ;;
    stop-all|down) cmd_stop_all ;;
    -h|--help|help) usage ;;
    cli|bin|rust)
      passthrough "$@"
      ;;
    # engine surface — same names as clap
    init|doctor|ingest|extract|remember|steer|pack64|unpack64|recall|pick|dream|label-basins|list-basins|browse-basin|mcp|rebuild-index|handshake|status-store)
      if [[ "$cmd" == "status-store" ]]; then
        passthrough status "$@"
      else
        passthrough "$cmd" "$@"
      fi
      ;;
    *)
      # unknown → try engine, else help
      if "$BIN" --help 2>/dev/null | grep -qE "^\\s+$cmd" || [[ -x "$BIN" ]]; then
        passthrough "$cmd" "$@"
      else
        usage
        return 1
      fi
      ;;
  esac
}

main "$@"
