# Copy to .env and edit. Every path below has a working default; you only need to set
# the ones that differ on your machine. `.env` is gitignored — personal paths stay local.
#
#   cp .env.example .env
#   ./run init

# --- where state lives (never inside the git checkout) -----------------------
# Stores, fetched datasets and logs. Default keeps everything under the repo in a
# gitignored directory, which is fine; point it at a bigger volume if you have one.
# SPLATRAG_RUNTIME=./splatrag-runtime

# --- local model processes ---------------------------------------------------
# llama-server binary. Resolved as: $LLAMA, then ~/.local/bin/llama-server, then PATH.
# LLAMA=/home/you/.local/bin/llama-server

# Directory holding your GGUF files.
# MODELS=/home/you/models

# Embedding model. This one is load-bearing for the claim — see corpora/README.md.
# EMBED_MODEL=$MODELS/Qwen3-Embedding-8B-Q8_0.gguf

# Optional labeler / vision model. Not needed to reproduce the claim.
# LABEL_MODEL=$MODELS/gemma-3-4b-it-q4_0.gguf

# --- ports (all loopback; the binary refuses to bind anything else) -----------
# SPLATRAG_EMBED_PORT=8081
# SPLATRAG_LABEL_PORT=8082
# SPLATRAG_LENS_PORT=8767
# SPLATRAG_CLAIM_PORT=8766
# SPLATRAG_PALACE_PORT=8080

# --- config used by `./run` --------------------------------------------------
# SPLATRAG_CONFIG=./splatrag.toml

# --- optional extras ---------------------------------------------------------
# Optional codebook for pack64/unpack64 --unicode. Only needed for packet transport.
# SPLATRAG_CODEBOOK=/path/to/codebook_256.json
